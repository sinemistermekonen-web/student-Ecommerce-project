# Environment Variables
#
# Copy this file to .env.local and fill in values as needed.
# Do NOT commit .env.local or any file containing real secrets.
#
# NEXT_PUBLIC_ variables are visible in the browser.
# Never place private keys or secrets in NEXT_PUBLIC_ variables.

# Example: Base URL for the app (used if needed for absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
